# Pointed at the real deployed API (Railway) so Expo Go on a physical
# phone works with zero local-network setup — no LAN IP, no tunnel needed
# for the API itself (only Metro's JS bundle needs same-WiFi or --tunnel).
#
# To test against your local API changes instead:
#   Web / iOS simulator: http://localhost:8000/api
#   Android emulator: http://10.0.2.2:8000/api (localhost inside the
#     emulator refers to the emulator itself, not your machine)
#   Physical device: your machine's LAN IP, e.g. http://192.168.1.23:8000/api,
#     with the API started via `php artisan serve --host=0.0.0.0`
EXPO_PUBLIC_API_URL=https://ripplebox-api-production.up.railway.app/api
