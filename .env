# Web / iOS simulator can reach the Laravel dev server via localhost.
# Android emulator: use http://10.0.2.2:8000/api instead (localhost inside
# the emulator refers to the emulator itself, not your machine).
# Physical device: use your machine's LAN IP, e.g. http://192.168.1.23:8000/api,
# and start the API with `php artisan serve --host=0.0.0.0`.
EXPO_PUBLIC_API_URL=http://localhost:8000/api
